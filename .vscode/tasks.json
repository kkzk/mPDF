// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": ["npm: watch", "npm: watch:tsc"],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watch"
			},
			"problemMatcher": {
				"owner": "esbuild",
				"pattern": { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
				"background": {
					"beginsPattern": "^\\[watch\\] build started",
					"endsPattern": "^\\[watch\\] build finished"
				}
			}
		},
		{
			"type": "npm",
			"script": "watch:tsc",
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"presentation": {
				"reveal": "never",
				"group": "watch"
			}
		}
	]
}
