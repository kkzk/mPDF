{
	"name": "mpdf",
	"displayName": "mPDF",
	"description": "Merge selected documents into PDF",
	"publisher": "kkzk",
	"version": "0.2.0",
	"repository": {
		"url": "https://github.com/kkzk/mPDF"
	},
	"preview": true,
	"icon": "media/mPDF-large.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "fileOrder.add",
				"title": "add pdf source",
				"icon": "$(add)"
			},
			{
				"command": "fileOrder.delete",
				"title": "delete pdf source",
				"icon": "$(remove)"
			},
			{
				"command": "fileOrder.select",
				"title": "select pdf source"
			},
			{
				"command": "fileOrder.publish",
				"title": "Publish PDF",
				"icon": "$(play)"
			},
			{
				"command": "fileOrder.merge",
				"title": "Merge PDF",
				"icon": "$(add)"
			},
			{
				"command": "fileOrder.preview",
				"title": "Show PDF Preview",
				"icon": "$(open-preview)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mPDF",
					"title": "Merge to PDF",
					"icon": "media/mPDF.svg"
				}
			]
		},
		"views": {
			"mPDF": [
				{
					"id": "fileExplorer",
					"name": "File Explorer",
					"icon": "media/mPDF.svg",
					"contextualTitle": "mPDF"
				},
				{
					"id": "fileOrder",
					"name": "file Order"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "fileOrder.preview",
					"when": "view == fileOrder",
					"group": "navigation"
				},
				{
					"command": "fileOrder.merge",
					"when": "view == fileOrder",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "fileOrder.add",
					"when": "view == fileExplorer && viewItem == file",
					"group": "inline"
				},
				{
					"command": "fileOrder.delete",
					"when": "view == fileOrder && viewItem == file",
					"group": "inline"
				},
				{
					"command": "fileOrder.publish",
					"when": "view == fileOrder && viewItem == file",
					"group": "inline"
				}
			],
			"commandPalette": [
				{
					"command": "fileOrder.add",
					"when": "false"
				},
				{
					"command": "fileOrder.delete",
					"when": "false"
				},
				{
					"command": "fileOrder.select",
					"when": "false"
				},
				{
					"command": "fileOrder.publish",
					"when": "false"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package-build",
		"check-types": "tsc --noEmit && tsc --noEmit -p src/webview",
		"compile": "npm run check-types && node esbuild.mjs",
		"package-build": "npm run check-types && node esbuild.mjs --production",
		"watch": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch",
		"lint": "eslint src",
		"compile-tests": "tsc -p ./tsconfig.test.json",
		"pretest": "npm run compile && npm run compile-tests && npm run lint",
		"test": "vscode-test",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"dependencies": {
		"exceljs": "^4.4.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.4.299"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.43",
		"@types/vscode": "~1.90.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"mocha": "^11.8.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1"
	}
}
